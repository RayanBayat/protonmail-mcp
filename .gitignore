# Dependencies and package-manager state
node_modules/
.pnpm-store/
.npm-cache/

# Local credentials, certificates and configuration — never commit these.
config.json
vault.json
vault.json.*
*.pem
*.crt
*.key
*.p12
.env
.env.*
!.env.example

# Test and packaging output
test-output/
*.tgz
*.log

# Editor / OS
.DS_Store
.idea/
*.swp

# Shared VS Code run/debug/test configuration is committed; anything else
# VS Code drops in there (per-user state) is not.
.vscode/*
!.vscode/launch.json
!.vscode/tasks.json
!.vscode/settings.json
!.vscode/extensions.json

# Superseded npm lockfile — pnpm-lock.yaml is the source of truth.
package-lock.json
